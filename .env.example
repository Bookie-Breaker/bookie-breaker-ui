# ui environment variables
#
# All URLs are read server-side only ($env/dynamic/private): the browser
# never talks to backend services directly — SvelteKit load functions and
# /api proxy routes do. In Docker Compose these point at internal DNS
# names (http://agent:8006, redis://redis:6379, ...).
PORT=3000
ORIGIN=http://localhost:3000
AGENT_URL=http://localhost:8006
BOOKIE_EMULATOR_URL=http://localhost:8005
LINES_SERVICE_URL=http://localhost:8001
STATISTICS_SERVICE_URL=http://localhost:8002
SIMULATION_ENGINE_URL=http://localhost:8003
PREDICTION_ENGINE_URL=http://localhost:8004

# Redis pub/sub for the live-updates SSE bridge (/api/events). Unset =
# the bridge degrades to a heartbeat-only stream.
REDIS_URL=redis://localhost:6379

# OTEL (ADR-012): unset disables all exporters.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=ui
